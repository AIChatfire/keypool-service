# ===== new-api 同款环境变量（推荐，优先识别） =====
# new-api 风格数据源，type 按 scheme 自动推断：
#   MySQL:      user:pass@tcp(host:3306)/newapi?charset=utf8mb4&parseTime=true
#   PostgreSQL: postgres://user:pass@host:5432/newapi?sslmode=disable
#   SQLite:     /path/to/new-api.db
SQL_DSN=root:root123456@tcp(127.0.0.1:3306)/newapi?charset=utf8mb4&parseTime=true

# Redis 连接串：redis://[:密码@]主机:端口[/db]
REDIS_CONN_STRING=redis://127.0.0.1:6379/0

# ===== 服务自身 =====
# HTTP 监听端口
PORT=8080
# 调用 /v1/key:get /v1/key:report 等接口的 Bearer 凭据（生产必改）
AUTH_TOKEN=change-me
# options 表（new-api 自动禁用配置 + keypool.* 扩展配置）轮询周期，秒
SYNC_INTERVAL_SEC=60

# ===== 细粒度覆盖（可选，一般不填） =====
# 显式指定数据库类型，覆盖 SQL_DSN scheme 推断：mysql|postgres|sqlite
#DATABASE_TYPE=
# 拆分式 Redis 配置（REDIS_CONN_STRING 未设置时生效）
#REDIS_ADDR=127.0.0.1:6379
#REDIS_PASS=
#REDIS_DB=0
# 拆分式数据库 DSN（SQL_DSN 未设置时生效）
#DATABASE_DSN=
