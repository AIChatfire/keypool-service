# keypool 环境变量（SPEC §7）。复制为 .env 后按部署环境修改。

# HTTP 监听端口
PORT=8080

# Bearer 鉴权 token：除 /healthz 外的所有接口都要求
# Authorization: Bearer <AUTH_TOKEN>，生产环境务必修改
AUTH_TOKEN=change-me

# 数据库类型：mysql | postgres | sqlite（复用 new-api 的
# channels / abilities / options 表）
DATABASE_TYPE=mysql

# 数据库 DSN：
#   mysql    user:pass@tcp(127.0.0.1:3306)/newapi?parseTime=true
#   postgres host=127.0.0.1 port=5432 user=postgres password=pass dbname=newapi sslmode=disable
#   sqlite   /path/to/new-api.db
DATABASE_DSN="user:pass@tcp(127.0.0.1:3306)/newapi?parseTime=true"

# Redis 地址/密码/库（锁、轮询游标、用量计数、幂等、事件流；
# 连接失败时服务以 degraded 模式运行，仅日志告警）
REDIS_ADDR=127.0.0.1:6379
REDIS_PASS=
REDIS_DB=0

# options 表配置轮询间隔（秒），new-api 侧开关与本服务的
# keypool.balance.* / keypool.rotation.* 配置按此周期同步
SYNC_INTERVAL_SEC=60
